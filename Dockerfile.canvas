# Dockerfile for Canvas Server (Optional)
# This is for users who want to run the visual canvas UI
# The canvas server provides the web interface and REST API

# Stage 1: Build frontend
FROM node:20-slim AS frontend-builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies for build)
RUN npm ci && npm cache clean --force

# Copy frontend source
COPY frontend ./frontend
COPY vite.config.js ./

# Build frontend
RUN npm run build:frontend

# Stage 2: Build backend (TypeScript compilation)
FROM node:20-slim AS backend-builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including TypeScript compiler)
RUN npm ci && npm cache clean --force

# Copy backend source
COPY src ./src
COPY tsconfig.json ./

# Compile TypeScript
RUN npm run build:server

# Stage 3: Production Canvas Server
FROM node:20-slim AS production

# Create non-root user for security, with a real home directory. npm needs a
# writable HOME to install as this user, and the server writes its pidfile/logs
# under homedir() at runtime.
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --gid 1001 --home /home/nodejs nodejs && \
    mkdir -p /home/nodejs && chown nodejs:nodejs /home/nodejs
ENV HOME=/home/nodejs

WORKDIR /app

# Own the workdir up front so dependencies install as the non-root user.
# This avoids a costly `chown -R` layer that would duplicate node_modules.
RUN chown nodejs:nodejs /app
USER nodejs

# Copy package files
COPY --chown=nodejs:nodejs package*.json ./

# Install only production dependencies.
# @excalidraw/excalidraw is a devDependency (used by the frontend build); the
# canvas server only needs its prod fonts at runtime, copied in below.
RUN npm ci --omit=dev && npm cache clean --force

# Copy compiled backend from builder stage
COPY --chown=nodejs:nodejs --from=backend-builder /app/dist ./dist

# Copy built frontend from frontend-builder stage
COPY --chown=nodejs:nodejs --from=frontend-builder /app/dist/frontend ./dist/frontend

# The canvas server serves Excalidraw's fonts (src/server.ts) so the export
# font-subsetting worker can fetch them. Ship only that fonts directory instead
# of the entire ~47MB @excalidraw/excalidraw package.
COPY --chown=nodejs:nodejs --from=frontend-builder \
     /app/node_modules/@excalidraw/excalidraw/dist/prod/fonts \
     ./node_modules/@excalidraw/excalidraw/dist/prod/fonts

# Set environment variables with defaults
ENV NODE_ENV=production
ENV PORT=3000
ENV HOST=0.0.0.0

# Expose port
EXPOSE 3000

# Run canvas server (web UI + REST API)
CMD ["node", "dist/server.js"]

# Labels for metadata
LABEL org.opencontainers.image.source="https://github.com/yctimlin/mcp_excalidraw"
LABEL org.opencontainers.image.description="MCP Excalidraw Canvas Server - Web UI and REST API"
LABEL org.opencontainers.image.licenses="MIT"
