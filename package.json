{
  "name": "mcp-excalidraw-server",
  "version": "2.1.2",
  "description": "Excalidraw toolkit for AI coding agents — agent skill, CLI, and MCP server with a live canvas",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-excalidraw-server": "dist/bin.js",
    "excalidraw-canvas": "dist/bin.js"
  },
  "scripts": {
    "start": "npm run build:server && node dist/index.js",
    "cli": "node dist/bin.js",
    "canvas": "npm run build:server && node dist/server.js",
    "build": "npm run build:frontend && npm run build:server",
    "build:frontend": "vite build",
    "build:server": "npx tsc && node scripts/build-excalidraw-node.mjs",
    "build:types": "npx tsc --emitDeclarationOnly",
    "dev": "concurrently \"npm run dev:server\" \"vite\"",
    "dev:server": "npx tsc --watch",
    "production": "npm run build && npm run canvas",
    "prepublishOnly": "npm run build",
    "sync:skills": "node scripts/sync-skills.mjs",
    "test": "npm run test:mcp && npm run test:bind && npm run test:render && npm run test:state && npm run test:durable",
    "test:bind": "npm run build:server && node scripts/check-local-bind.mjs",
    "test:mcp": "npm run build:server && node scripts/check-mcp-stdio.mjs",
    "test:render": "npm run build:server && node scripts/check-render.mjs",
    "test:state": "npm run build:server && node scripts/check-state-integrity.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "test:canvas": "npm run build && playwright test",
    "type-check:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "test:durable": "npm run build:server && node scripts/check-durable-state.mjs",
    "type-check": "npx tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "jsdom": "^26.1.0",
    "winston": "^3.11.0",
    "ws": "^8.21.3",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.3"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^1.1.3",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.25.12",
    "mermaid": "^11.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wawoff2": "^2.0.1"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "excalidraw",
    "model-context-protocol",
    "ai",
    "drawing",
    "diagrams",
    "canvas",
    "real-time",
    "websocket",
    "visualization",
    "claude",
    "ai-tools",
    "claude-skill",
    "agent-skills",
    "cli",
    "ai-agents"
  ],
  "author": {
    "name": "yctimlin",
    "email": "c22647809@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yctimlin/mcp_excalidraw.git"
  },
  "homepage": "https://github.com/yctimlin/mcp_excalidraw#readme",
  "bugs": {
    "url": "https://github.com/yctimlin/mcp_excalidraw/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src/**/*",
    "dist/**/*",
    "skills/**/*",
    "assets/**/*",
    "*.d.ts",
    "README.md",
    "LICENSE"
  ]
}
